# Copiare in dev.properties SOLO per usare un database esterno o una porta HTTP diversa.
# dev.properties e' escluso da Git: le password restano solo su questo computer.
# Le variabili d'ambiente con lo stesso nome hanno precedenza.
#
# Con il database portabile dei task VS Code questo file non serve:
# Start-Database.ps1 genera utente e password in .local-db/credentials.properties.
DB_URL=jdbc:mysql://127.0.0.1:3306/ecommerce?serverTimezone=UTC&connectTimeout=5000
DB_USER=
DB_PASSWORD=
HTTP_PORT=8080
